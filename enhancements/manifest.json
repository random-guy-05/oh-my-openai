{
  "version": 1,
  "platforms": ["mac-x64"],
  "enhancements": [
    {
      "id": "opencodex",
      "type": "service",
      "source": "npm:@bitkyc08/opencodex@2.12.0",
      "config": {
        "port": 10100
      },
      "lifecycle": "launcher",
      "startCommand": [
        "node_modules/bun/bin/bun.exe",
        "run",
        "node_modules/@bitkyc08/opencodex/bin/ocx.mjs",
        "start"
      ],
      "ui": {
        "label": "OpenCodex Gateway",
        "kind": "web",
        "openLabel": "Open Dashboard",
        "url": "http://127.0.0.1:10100"
      }
    },
    {
      "id": "nerftrack",
      "type": "tool",
      "source": "github:NerfTrack/NerfTrack@v1.1.2",
      "asset": "NerfTrack-1.1.2-macos-x86_64.dmg",
      "sha256": "5e132574fd6216516095f17bd20ad8fc5a3b6c2aad8971a75f4f37ac732994f7",
      "appPath": "NerfTrack.app",
      "description": "Native local dashboard for Codex usage, history, quota, diagnostics, and API-equivalent value estimates.",
      "verify": ["NerfTrack.app/Contents/Info.plist"],
      "ui": {
        "label": "NerfTrack Usage Dashboard",
        "kind": "app",
        "openLabel": "Open NerfTrack"
      }
    },
    {
      "id": "codex-chatgpt-web",
      "type": "tool",
      "source": "github:miuuyy/codex-chatgpt-web@v2.1.7",
      "dependencies": ["npm:bun@1.3.14"],
      "description": "ChatGPT Web bridge setup and diagnostics using the isolated Codex profile.",
      "toolCommand": ["node_modules/bun/bin/bun.exe", "run", "--cwd", "source", "src/cli.ts", "doctor"],
      "verify": ["source/package.json", "node_modules/bun/bin/bun.exe"],
      "ui": {
        "label": "ChatGPT Web Bridge (Setup)",
        "kind": "terminal",
        "openLabel": "Open Setup Terminal"
      }
    }
  ]
}
