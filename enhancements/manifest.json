{
  "version": 1,
  "platforms": ["mac-x64"],
  "enhancements": [
    {
      "id": "opencodex",
      "type": "service",
      "source": "npm:@bitkyc08/opencodex@2.12.0",
      "overlay": "assets/opencodex-runtime",
      "config": {
        "port": 10100
      },
      "healthPath": "/healthz",
      "required": true,
      "codexHome": "OpenCodexHome",
      "lifecycle": "launcher",
      "startCommand": [
        "node_modules/bun/bin/bun",
        "run",
        "node_modules/@bitkyc08/opencodex/bin/ocx.mjs",
        "start"
      ],
      "postStartCommand": [
        "node_modules/bun/bin/bun",
        "run",
        "post-start.js"
      ],
      "verify": ["post-start.js"],
      "ui": {
        "label": "OpenCodex Gateway",
        "kind": "web",
        "openLabel": "Open Dashboard",
        "url": "http://127.0.0.1:10100"
      }
    },
    {
      "id": "nerftrack",
      "type": "tool",
      "source": "github:NerfTrack/NerfTrack@v1.1.2",
      "asset": "NerfTrack-1.1.2-macos-x86_64.dmg",
      "sha256": "5e132574fd6216516095f17bd20ad8fc5a3b6c2aad8971a75f4f37ac732994f7",
      "appPath": "NerfTrack.app",
      "description": "Native local dashboard for Codex usage, history, quota, diagnostics, and API-equivalent value estimates.",
      "verify": ["NerfTrack.app/Contents/Info.plist"],
      "ui": {
        "label": "NerfTrack Usage Dashboard",
        "kind": "app",
        "openLabel": "Open NerfTrack"
      }
    },
    {
      "id": "codex-chatgpt-web",
      "type": "service",
      "source": "github:miuuyy/codex-chatgpt-web@v2.1.11",
      "asset": "codex-chatgpt-web-darwin-amd64.tar.gz",
      "sha256": "447f37729c8709dfd72a5acf8d195376774e8b49e3ce05015dac61933c8d83a1",
      "overlay": "assets/codex-chatgpt-web-dashboard",
      "config": {
        "port": 17842
      },
      "healthPath": "/healthz",
      "readinessPath": "/api/status",
      "codexHome": "ChatGPTWebHome",
      "lifecycle": "launcher",
      "startCommand": [
        "runtime/bun",
        "run",
        "server.js",
        "--port",
        "17842"
      ],
      "connectCommand": [
        "runtime/bun",
        "run",
        "login.js"
      ],
      "description": "In-Codex localhost dashboard for the upstream ChatGPT Web bridge, loopback health, diagnostics, and the signed-in ChatGPT Web surface.",
      "verify": ["server.js", "login.js", "public/index.html"],
      "ui": {
        "label": "Codex ChatGPT Web",
        "kind": "web",
        "openLabel": "Open ChatGPT Dashboard",
        "connectLabel": "Connect ChatGPT",
        "url": "http://127.0.0.1:17842"
      }
    }
  ]
}
